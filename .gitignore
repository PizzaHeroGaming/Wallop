# Node / npm (only present if you set up Capacitor or other tooling)
node_modules/
package-lock.json
npm-debug.log*

# Local Claude Code state (your machine only — not for sharing)
# We DO commit .claude/settings.json so the team shares permissions,
# but everything else under .claude/ is per-machine.
.claude/cache/
.claude/sessions/
.claude/local-*
.claude/worktrees/
.claude/launch.json

# Capacitor / native wrappers
# android/ IS committed — we customize the manifest (landscape lock, AdMob App
# ID), icons, and signing config, so it's version-controlled. Its own
# android/.gitignore excludes machine-specific bits (local.properties, build/,
# the copied web assets under app/src/main/assets/public).
ios/
www/

# Build output
dist/
build/

# OS junk
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Editor / IDE
.vscode/
.idea/
*.code-workspace

# Logs / scratch
*.log
/tmp-*
/scratch-*

# Generated icon sources (rasterized from assets/icons/icon.svg by scripts/gen-icon-sources.js)
cap-resources/

# Brand font binaries used only by scripts/gen-steam-art.mjs — re-downloadable
# (see the curl commands / comments). Keeps font binaries out of the repo.
store/.fonts/
