# Copy to android/keystore.properties and fill in your real values.
# keystore.properties is git-ignored — it holds your signing passwords and must
# NEVER be committed. Keep a backup of the .jks file + these passwords somewhere
# safe (a password manager); without them you cannot push updates to Play.
#
# storeFile is relative to android/app/ (so a keystore at android/upload-keystore.jks
# is "../upload-keystore.jks").

storeFile=../upload-keystore.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
