// WALLOP — SteamPipe depot build script (desktop / Windows).
//
// The depot content is the electron-builder "dir" target output — the fully
// unpacked game (WALLOP.exe + resources/, incl. the bundled www/ game files and
// the unpacked steamworks.js native module). Do NOT upload the NSIS installer:
// on Steam, Steam itself is the installer/updater.
//
// Build the unpacked app first:  cd electron && npm run dist   (produces
// electron/dist/win-unpacked/).
//
// contentroot is intentionally NOT set here — it is inherited from the app
// build config (app_build_4910280.vdf). steamcmd resolves a depot-level
// contentroot RELATIVE TO the app's contentroot (not the depot file), so
// specifying it here again doubled the path ("...\electron\electron\dist\...")
// and failed. Define contentroot once, in the app build config.
//
// Depot ID 4910281 confirmed in the dashboard (App Admin → 4910280 →
// SteamPipe → Depots → "WALLOP Content").
"DepotBuildConfig"
{
	"DepotID" "4910281"

	"FileMapping"
	{
		"LocalPath" "*"
		"DepotPath" "."
		"recursive" "1"
	}

	// Symbols aren't needed by players.
	"FileExclusion" "*.pdb"
}
